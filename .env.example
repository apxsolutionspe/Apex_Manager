# Copiar como .env y cargar estas variables en el entorno, no subir secretos a Git.
DB_PATH=./data/apex.db
DEMO_MODE=true
APP_ENV=development
# Cambiar a true SOLO después de aprobar una política de privacidad definitiva.
PRIVACY_NOTICE_APPROVED=false
# Solo URL HTTPS de la política aprobada y publicada en sitio propio.
PRIVACY_POLICY_URL=
PRIVACY_NOTICE_VERSION=2026-10-draft-1
# Apagado por defecto: previene recopilación accidental de datos personales.
QUOTE_INTAKE_ENABLED=false
# Generar: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
# Generar: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Número comercial autorizado en formato internacional: 51987654321 (EJEMPLO; reemplazar)
WHATSAPP_NUMBER=
